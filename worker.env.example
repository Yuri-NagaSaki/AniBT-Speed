# Required. QBT_URL should reach qB directly on the local Docker host.
QBT_URL=http://host.docker.internal:8181
QBT_API_KEY=
DOWNLOAD_ROOT=/media/AniBT
CATEGORY=AniBT
MANAGED_TAG=AniBT
EXCLUDED_TAGS=keep

# AniBT API and admission policy; excluded groups do not create new subscriptions/downloads.
ANIBT_API_URL=https://anibt.net
ANIBT_API_TOKEN=
ANIBT_EXCLUDED_GROUP_SLUGS=kirara-fantasia,ani,zzz123,pre-s,silent-workshop

# Control: one qB caller, shared incremental state, bounded time and commands.
CONTROL_INTERVAL_SECONDS=30
CONTROL_BUDGET_SECONDS=20
CONTROL_MAX_COMMANDS=8
CONTROL_BACKOFF_MAX_SECONDS=300
QBT_TIMEOUT_SECONDS=8
QBT_CONNECT_TIMEOUT_SECONDS=3
DRY_RUN=false

# Feeds: bounded concurrent reads; bootstrap each new feed once.
RSS_ENABLED=true
RSS_POLL_SECONDS=300
RSS_CONCURRENCY=3
RSS_MAX_AGE_HOURS=48
RSS_FEED_LIMIT=100
BOOTSTRAP_HISTORY=true
DOWNLOAD_BATCH=3
PREPARE_BATCH=4
MAX_TORRENT_GIB=0

# Seeding pool: demand, recent completion and manually forced states stay protected.
POOL_ENABLED=true
POOL_TARGET=300
POOL_BATCH=40
ROTATION_BATCH=10
ROTATION_INTERVAL_SECONDS=180
EXPOSURE_SECONDS=600
HOT_HOURS=12

# Cleanup: completed managed torrents only; 0 retention disables age expiry.
CLEANUP_ENABLED=true
CLEANUP_INTERVAL_SECONDS=300
CLEANUP_BATCH=5
PROTECT_HOURS=8
RETAIN_DAYS=90
MIN_FREE_GIB=100
DISK_MAX_USED_PERCENT=85

# Optional rate limits. Units are MiB/s and GiB.
RATE_ENABLED=false
UPLOAD_MIB=100
DOWNLOADING_UPLOAD_MIB=80
DOWNLOAD_MIB=60
HOURLY_UPLOAD_GIB=0
DAILY_UPLOAD_GIB=0

# Integrated media queue. The download volume must be mounted read-only at the qB path.
MEDIAINFO_ENABLED=false
MEDIAINFO_INTERVAL_SECONDS=30
MEDIAINFO_SAMPLE_FILES=6
MEDIAINFO_TIMEOUT_SECONDS=25
MEDIAINFO_MEMORY_MB=256
MEDIAINFO_IO_PRESSURE_LIMIT=30

# Optional notifications, independent of control and media work.
NOTIFICATIONS_ENABLED=false
NOTIFY_TOKEN=
NOTIFY_CHAT_ID=
NOTIFY_DOWNLOADS=true
NOTIFY_CLEANUPS=true
DAILY_SUMMARY_HOUR=20
TIMEZONE=Asia/Shanghai

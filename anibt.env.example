# AniBT 2: native worker. All settings use the ANIBT_ namespace.
# Blank credentials must be filled before starting. Durations require units.
ANIBT_QBT_URL=http://127.0.0.1:8181
ANIBT_QBT_API_KEY=
ANIBT_API_URL=https://anibt.net
ANIBT_API_TOKEN=
ANIBT_STATE_DIR=/var/lib/anibt
ANIBT_QBT_DOWNLOAD_ROOT=/media/AniBT
ANIBT_MEDIA_ROOT=/hdd/media/AniBT
ANIBT_CATEGORY=AniBT
ANIBT_PROTECTED_TAGS=keep
ANIBT_EXCLUDED_GROUPS=kirara-fantasia,ani,zzz123,pre-s,silent-workshop
ANIBT_CONTROL_INTERVAL=30s
ANIBT_CONTROL_BUDGET=20s
ANIBT_CONTROL_COMMANDS=8
ANIBT_QBT_TIMEOUT=8s
ANIBT_FEED_INTERVAL=5m
ANIBT_FEED_SYNC_INTERVAL=12h
ANIBT_FEED_CONCURRENCY=3
ANIBT_FEED_LIMIT=100
ANIBT_RELEASE_MAX_AGE=48h
ANIBT_BOOTSTRAP_HISTORY=true
ANIBT_FEEDS_ENABLED=true
ANIBT_PREPARE_BATCH=4
ANIBT_ADD_BATCH=3
ANIBT_CONFIRM_TIMEOUT=2m
ANIBT_STALL_TIMEOUT=6h
ANIBT_MAX_TORRENT_GIB=0
ANIBT_POOL_ENABLED=true
ANIBT_POOL_TARGET=300
ANIBT_POOL_BATCH=40
ANIBT_ROTATION_BATCH=10
ANIBT_ROTATION_INTERVAL=3m
ANIBT_EXPOSURE=10m
ANIBT_HOT_WINDOW=12h
ANIBT_CLEANUP_ENABLED=true
ANIBT_CLEANUP_INTERVAL=5m
ANIBT_CLEANUP_BATCH=5
ANIBT_CLEANUP_PROTECT=8h
ANIBT_RETAIN_DAYS=90
ANIBT_MIN_FREE_GIB=100
ANIBT_MAX_DISK_PERCENT=85
ANIBT_RATE_ENABLED=false
ANIBT_UPLOAD_MIB=100
ANIBT_DOWNLOADING_UPLOAD_MIB=80
ANIBT_DOWNLOAD_MIB=60
ANIBT_HOURLY_UPLOAD_GIB=0
ANIBT_DAILY_UPLOAD_GIB=0
ANIBT_HISTORY_DAYS=90
ANIBT_MEDIA_ENABLED=true
ANIBT_MEDIA_INTERVAL=5s
ANIBT_MEDIA_SAMPLES=6
ANIBT_MEDIA_TIMEOUT=25s
ANIBT_MEDIA_MEMORY_MIB=256
ANIBT_MEDIA_IO_PRESSURE=30
ANIBT_TELEGRAM_ENABLED=true
ANIBT_TELEGRAM_TOKEN=
ANIBT_TELEGRAM_CHAT_ID=
ANIBT_SUMMARY_HOUR=20
ANIBT_TIMEZONE=Asia/Shanghai
ANIBT_MAX_ATTEMPTS=12
